{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octoberblue:run-request:v1",
  "title": "run-request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest",
    "ticket_id",
    "account_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "manifest": {
      "$ref": "octoberblue:run-manifest:v1"
    },
    "ticket_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    }
  }
}
