{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octoberblue:trace:v1",
  "title": "trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "origin",
              "kind",
              "detail"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
              },
              "origin": {
                "const": "execution_harness"
              },
              "kind": {
                "const": "run_started"
              },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "task_id",
                  "task_family",
                  "task_sha256",
                  "case_sha256",
                  "surface",
                  "partition",
                  "seed",
                  "synthetic_only",
                  "target_runtime",
                  "defense_sha256",
                  "gateway_sha256"
                ],
                "properties": {
                  "task_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
                  },
                  "task_family": {
                    "const": "synthetic_support_ticket"
                  },
                  "task_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "case_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "surface": {
                    "enum": [
                      "ticket_body",
                      "retrieved_knowledge_snippet",
                      "tool_response_body"
                    ]
                  },
                  "partition": {
                    "const": "development"
                  },
                  "seed": {
                    "type": "integer"
                  },
                  "synthetic_only": {
                    "const": true
                  },
                  "target_runtime": {
                    "enum": [
                      "in_memory",
                      "docker"
                    ]
                  },
                  "defense_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "gateway_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "origin",
              "kind",
              "detail"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
              },
              "origin": {
                "const": "execution_harness"
              },
              "kind": {
                "const": "input_received"
              },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "surface",
                  "trust",
                  "payload_sha256",
                  "case_version"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9:/._-]{0,255}$"
                  },
                  "surface": {
                    "enum": [
                      "ticket_body",
                      "retrieved_knowledge_snippet",
                      "tool_response_body"
                    ]
                  },
                  "trust": {
                    "const": "untrusted"
                  },
                  "payload_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "case_version": {
                    "const": "1.0"
                  },
                  "guard_decision": {
                    "$ref": "octoberblue:guard-decision:v1"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "origin",
              "kind",
              "detail"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
              },
              "origin": {
                "const": "execution_harness"
              },
              "kind": {
                "const": "content_delivered"
              },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "surface",
                  "trust",
                  "payload_sha256"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9:/._-]{0,255}$"
                  },
                  "surface": {
                    "enum": [
                      "ticket_body",
                      "retrieved_knowledge_snippet",
                      "tool_response_body"
                    ]
                  },
                  "trust": {
                    "const": "untrusted"
                  },
                  "payload_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "origin",
              "kind",
              "detail"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
              },
              "origin": {
                "const": "blue_guard"
              },
              "kind": {
                "const": "filter"
              },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "blocked",
                  "surface",
                  "source_id",
                  "defense_id"
                ],
                "properties": {
                  "blocked": {
                    "const": true
                  },
                  "surface": {
                    "enum": [
                      "ticket_body",
                      "retrieved_knowledge_snippet",
                      "tool_response_body"
                    ]
                  },
                  "source_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9:/._-]{0,255}$"
                  },
                  "defense_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "origin",
              "kind",
              "detail"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
              },
              "origin": {
                "const": "target_agent"
              },
              "kind": {
                "const": "tool_request"
              },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tool",
                  "intent",
                  "task_authorized"
                ],
                "properties": {
                  "tool": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
                  },
                  "intent": {
                    "type": "string"
                  },
                  "task_authorized": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "origin",
              "kind",
              "detail"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
              },
              "origin": {
                "const": "execution_harness"
              },
              "kind": {
                "const": "tool_executed"
              },
              "detail": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "request_event_id",
                      "ticket_id"
                    ],
                    "properties": {
                      "tool": {
                        "const": "get_ticket"
                      },
                      "request_event_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
                      },
                      "ticket_id": {
                        "type": "string",
                        "maxLength": 100
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "request_event_id",
                      "account_id"
                    ],
                    "properties": {
                      "tool": {
                        "const": "get_account_summary"
                      },
                      "request_event_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
                      },
                      "account_id": {
                        "type": "string",
                        "maxLength": 100
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "request_event_id",
                      "ticket_id",
                      "priority",
                      "reply_code"
                    ],
                    "properties": {
                      "tool": {
                        "const": "draft_reply"
                      },
                      "request_event_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
                      },
                      "ticket_id": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "priority": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "reply_code": {
                        "type": "string",
                        "maxLength": 100
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "request_event_id",
                      "ticket_id",
                      "status"
                    ],
                    "properties": {
                      "tool": {
                        "const": "update_ticket_status"
                      },
                      "request_event_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
                      },
                      "ticket_id": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "status": {
                        "type": "string",
                        "maxLength": 100
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "request_event_id",
                      "sink",
                      "record"
                    ],
                    "properties": {
                      "tool": {
                        "const": "send_external_message"
                      },
                      "request_event_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
                      },
                      "sink": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "record": {
                        "type": "string",
                        "maxLength": 100
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "request_event_id",
                      "sink",
                      "record"
                    ],
                    "properties": {
                      "tool": {
                        "const": "export_customer_data"
                      },
                      "request_event_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
                      },
                      "sink": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "record": {
                        "type": "string",
                        "maxLength": 100
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "request_event_id",
                      "account_id",
                      "role"
                    ],
                    "properties": {
                      "tool": {
                        "const": "change_user_permissions"
                      },
                      "request_event_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
                      },
                      "account_id": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "role": {
                        "type": "string",
                        "maxLength": 100
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "origin",
              "kind",
              "detail"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
              },
              "origin": {
                "const": "execution_harness"
              },
              "kind": {
                "const": "tool_denied"
              },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tool",
                  "request_event_id",
                  "reason"
                ],
                "properties": {
                  "tool": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
                  },
                  "request_event_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
                  },
                  "reason": {
                    "enum": [
                      "capability",
                      "quota",
                      "schema",
                      "policy",
                      "transition"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "origin",
              "kind",
              "detail"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
              },
              "origin": {
                "const": "execution_harness"
              },
              "kind": {
                "const": "ticket_snapshot"
              },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "ticket_reads",
                  "account_reads",
                  "drafts",
                  "outbox",
                  "exports",
                  "permissions",
                  "premature_close",
                  "synthetic_only"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "open",
                      "resolved",
                      "closed"
                    ]
                  },
                  "ticket_reads": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "account_reads": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "drafts": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "outbox": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "maxLength": 100
                    }
                  },
                  "exports": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "maxLength": 100
                    }
                  },
                  "permissions": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "maxLength": 100
                    }
                  },
                  "premature_close": {
                    "type": "boolean"
                  },
                  "synthetic_only": {
                    "const": true
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "origin",
              "kind",
              "detail"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
              },
              "origin": {
                "const": "execution_harness"
              },
              "kind": {
                "const": "target_runtime_failed"
              },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reason_code"
                ],
                "properties": {
                  "reason_code": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "origin",
              "kind",
              "detail"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
              },
              "origin": {
                "const": "execution_harness"
              },
              "kind": {
                "const": "witness_acquisition_failed"
              },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "origin",
              "kind",
              "detail"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}:[0-9]{4}$"
              },
              "origin": {
                "const": "independent_verifier"
              },
              "kind": {
                "const": "verdict"
              },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "task_success",
                  "attack_attempted",
                  "unauthorized_effect",
                  "verdict",
                  "transport"
                ],
                "properties": {
                  "task_success": {
                    "type": "boolean"
                  },
                  "attack_attempted": {
                    "type": "boolean"
                  },
                  "unauthorized_effect": {
                    "type": "boolean"
                  },
                  "verdict": {
                    "enum": [
                      "pass",
                      "fail",
                      "indeterminate"
                    ]
                  },
                  "transport": {
                    "const": "subprocess"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
