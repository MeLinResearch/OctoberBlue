{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octoberblue:provider-call-request:v1",
  "title": "provider-call-request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "call_id",
    "role",
    "model_pin_sha256",
    "price_quote_sha256",
    "input_tokens_upper_bound",
    "output_tokens_upper_bound"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "call_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "role": {
      "enum": [
        "red_researcher",
        "red_attacker",
        "blue_researcher",
        "blue_guard",
        "target_agent"
      ]
    },
    "model_pin_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "price_quote_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_tokens_upper_bound": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "output_tokens_upper_bound": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    }
  }
}
