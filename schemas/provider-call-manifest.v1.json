{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octoberblue:provider-call-manifest:v1",
  "title": "provider-call-manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request",
    "model_pin",
    "pricing",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request": {
      "$ref": "octoberblue:provider-call-request:v1"
    },
    "model_pin": {
      "$ref": "octoberblue:model-pin:v1"
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_sha256",
        "source_sha256",
        "input_dollars_per_million",
        "output_dollars_per_million"
      ],
      "properties": {
        "quote_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_dollars_per_million": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,6})(?:\\.[0-9]{1,12})?$"
        },
        "output_dollars_per_million": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,6})(?:\\.[0-9]{1,12})?$"
        }
      }
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
