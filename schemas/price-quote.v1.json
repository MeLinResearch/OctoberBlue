{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octoberblue:price-quote:v1",
  "title": "price-quote v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_pin_sha256",
    "currency",
    "billing_basis",
    "input_dollars_per_million",
    "output_dollars_per_million",
    "source_url",
    "source_sha256",
    "reviewed_by",
    "verified_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "model_pin_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "currency": {
      "const": "USD"
    },
    "billing_basis": {
      "const": "all_input_all_output_tokens"
    },
    "input_dollars_per_million": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,6})(?:\\.[0-9]{1,12})?$"
    },
    "output_dollars_per_million": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,6})(?:\\.[0-9]{1,12})?$"
    },
    "source_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewed_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "verified_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 253402300799
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 253402300799
    }
  }
}
