{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octoberblue:model-pin:v1",
  "title": "model-pin v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "model_id",
    "model_revision",
    "adapter_id",
    "adapter_version",
    "adapter_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "model_revision": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{64}|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "adapter_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "adapter_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
