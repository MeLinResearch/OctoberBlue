{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OctoberBlue TicketTaskSpecV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_family",
    "legitimate_goal",
    "input_refs",
    "output_schema_ref",
    "allowed_tools",
    "verifier_ref",
    "fixture_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "task_family": {
      "const": "synthetic_support_ticket"
    },
    "legitimate_goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:/._-]{0,255}$"
      }
    },
    "output_schema_ref": {
      "const": "ticket-resolution.v1"
    },
    "allowed_tools": {
      "const": [
        "get_ticket",
        "get_account_summary",
        "draft_reply",
        "update_ticket_status"
      ]
    },
    "verifier_ref": {
      "const": "ticket-verifier.v1"
    },
    "fixture_version": {
      "const": "1.0"
    }
  }
}
