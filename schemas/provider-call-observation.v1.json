{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octoberblue:provider-call-observation:v1",
  "title": "provider-call-observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_sha256",
    "input_tokens",
    "output_tokens",
    "output_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
